# LLM Configuration
# Provider can be: openai, vertex_ai, bedrock, ollama
LLM_PROVIDER=vertex_ai
LLM_MODEL=gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Google Cloud / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# AWS Bedrock (if using)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# OpenAI (if using)
# OPENAI_API_KEY=sk-...

# Ollama (if using local)
# OLLAMA_BASE_URL=http://localhost:11434

# MCP Servers Configuration
MCP_FILESYSTEM_COMMAND=python
MCP_FILESYSTEM_ARGS=mcp_servers/filesystem/server.py
MCP_GMAIL_COMMAND=python
MCP_GMAIL_ARGS=mcp_servers/gmail/server.py

# Gmail API Configuration
GMAIL_CREDENTIALS_PATH=/path/to/gmail-credentials.json
GMAIL_TOKEN_PATH=/path/to/gmail-token.json

# Application Settings
LOG_LEVEL=INFO
